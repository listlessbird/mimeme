set dotenv-load := true

default:
    @just --list

sync:
    uv sync --all-groups --all-extras

fmt:
    uv run ruff check --select I --fix src tests
    uv run ruff format src tests

lint:
    uv run ruff format --check src tests
    uv run ruff check src tests

type:
    uv run pyright -p .

test:
    uv run pytest -q

test-model:
    RUN_MODEL_SMOKE=1 uv run --all-extras pytest -q --tb=short --show-capture=no tests/compute/test_model_smoke.py

cov:
    uv run pytest --cov=src --cov-report=term-missing -q

check: lint type test

hooks-install:
    uv run pre-commit install

hooks:
    uv run pre-commit run --all-files

api:
    uv run uvicorn mimeme.api.main:app --reload

worker:
    uv run python -m mimeme.worker

compute:
    uv run python -m mimeme.compute

migrate:
    uv run alembic upgrade head

# Generate a migration by diffing the ORM against the DB (run `just migrate` first
# so the diff baseline is head). Review the output: enums need CREATE/DROP TYPE by
# hand, name your constraints, and prune unrelated drift before applying.
makemigration name:
    uv run alembic revision --autogenerate -m "{{name}}"

# Roll back one revision.
migrate-down:
    uv run alembic downgrade -1

prod-env:
    ./scripts/print-prod-env.sh

# Copy a subset of production into the local stack. Reads prod read-only;
# truncates the local application tables. Drop `--apply` for a dry run.
seed-local limit="500":
    uv run python scripts/seed_from_prod.py --limit {{limit}} --apply

modal-deploy:
    ./scripts/deploy-modal.sh

deploy:
    docker compose -f docker.compose.prod.yml pull api worker
    docker compose -f docker.compose.prod.yml up -d
