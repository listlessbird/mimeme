# Release tag published by .github/workflows/backend-image.yml.
IMAGE_TAG=<release-sha>

# Bind port 8010 only to this machine's Tailscale IPv4 address.
GPU_GATEWAY_BIND_IP=100.x.y.z

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Ship structured compute logs to the same Axiom dataset as the Pi services.
LOG_AXIOM_DATASET=<axiom-dataset>
LOG_AXIOM_API_TOKEN=<axiom-ingest-token>
LOG_AXIOM_REGION=us-east-1.aws.edge.axiom.co

# The GPU gateway reads canonical images and writes embedding artifacts directly.
# Both endpoints must be reachable from the GPU machine.
MEDIA_S3_ENDPOINT_URL=https://<media-s3-endpoint>
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=<media-access-key>
MEDIA_S3_SECRET_ACCESS_KEY=<media-secret-key>
MEDIA_S3_BUCKET=mimeme-media
MEDIA_S3_FORCE_PATH_STYLE=false

ARTIFACT_S3_ENDPOINT_URL=https://<artifact-s3-endpoint>
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ACCESS_KEY_ID=<artifact-access-key>
ARTIFACT_S3_SECRET_ACCESS_KEY=<artifact-secret-key>
ARTIFACT_S3_BUCKET=mimeme-artifacts
ARTIFACT_S3_FORCE_PATH_STYLE=false

INFERENCE_VISION_MODEL=vikhyatk/moondream2
INFERENCE_VISION_MODEL_REVISION=2025-06-21
INFERENCE_EMBED_MODEL=google/siglip2-base-patch16-naflex
INFERENCE_EMBED_DEVICE=cuda
INFERENCE_RESIDENCY=both
INFERENCE_EMBED_BATCH_SIZE=4

# Shared bound across inference-job media downloads and artifact uploads.
COMPUTE_JOB_IO_CONCURRENCY=4
COMPUTE_REQUEST_TIMEOUT_S=300

# Recommended to avoid anonymous Hugging Face Hub rate limits.
HF_TOKEN=<hugging-face-token>
