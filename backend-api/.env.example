
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Tumblr OAuth consumer key used by tumblr_tagged sources.
TUMBLR_API_KEY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimeme


TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mimeme-v2
# Inference backend: local = an HTTP compute gateway; modal = the Modal app.
# Allowed values: local | modal (default: local)
# A "local" gateway may be on this host, Compose, or a remote Tailscale machine.
COMPUTE_GPU_BACKEND=local
COMPUTE_MODAL_APP_NAME=findmeme-gpu
# Compute gateway the API/worker call for image, search, and index work.
# In Compose this is http://compute:8010; host tools use http://127.0.0.1:8010.
COMPUTE_GATEWAY_URL=http://127.0.0.1:8010
# Optional inference-only gateway (Moondream/SigLIP). Falls back to the main gateway.
# Examples:
#   unset                         -> use COMPUTE_GATEWAY_URL
#   http://127.0.0.1:8010         -> inference on this host
#   http://compute:8010           -> inference in the local Compose network
#   http://mimeme-gpu:8010        -> inference on a Tailscale host
# COMPUTE_INFERENCE_GATEWAY_URL=http://mimeme-gpu:8010
# COMPUTE_BIND_HOST=0.0.0.0
# COMPUTE_BIND_PORT=8010
# COMPUTE_SOCKET_DIR=/tmp/mimeme-compute
# Long-poll timeout and progress cadence; completed jobs return immediately.
# COMPUTE_POLL_INTERVAL_S=5.0
# COMPUTE_HEARTBEAT_TIMEOUT_S=30.0
# Maximum concurrent media downloads and artifact uploads across compute jobs.
COMPUTE_JOB_IO_CONCURRENCY=4

MEDIA_S3_ENDPOINT_URL=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=minioadmin
MEDIA_S3_SECRET_ACCESS_KEY=minioadmin
MEDIA_S3_BUCKET=mimeme-media
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/mimeme-media

ARTIFACT_S3_ENDPOINT_URL=http://localhost:9000
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ACCESS_KEY_ID=minioadmin
ARTIFACT_S3_SECRET_ACCESS_KEY=minioadmin
ARTIFACT_S3_BUCKET=mimeme-artifacts
ARTIFACT_S3_FORCE_PATH_STYLE=true

INFERENCE_VISION_MODEL=vikhyatk/moondream2
INFERENCE_VISION_MODEL_REVISION=2025-06-21
# Experimental: benchmark output parity and latency before enabling.
INFERENCE_VISION_COMPILE=false
INFERENCE_EMBED_MODEL=google/siglip2-base-patch16-naflex
INFERENCE_EMBED_DEVICE=cuda
# Model residency. Allowed values:
#   both -> keep Moondream and SigLIP loaded; measured production default
#   swap -> keep only the active model loaded; opt in for memory-constrained GPUs
INFERENCE_RESIDENCY=both
# Maximum SigLIP items per GPU forward pass; any integer >= 1.
# Starting points: 8 GB = 2 or 4; 12 GB = 4 or 8; 16 GB = 4, 8, or 16.
INFERENCE_EMBED_BATCH_SIZE=4
SEARCH_ENCODER_REPO=listlessbird/siglip2-base-patch16-naflex-text-onnx
SEARCH_ENCODER_REVISION=092dc08370b1a01d69c78067051b124881a95407
SEARCH_ENCODER_VARIANT=text_model_int8.onnx
SEARCH_ENCODER_THREADS=4
SEARCH_HNSW_EF_SEARCH=128

INDEX_TYPE=hnsw
INDEX_CACHE_DIR=data/cache/indexes
INDEX_REBUILD_CLAIM_TIMEOUT_MINUTES=180
INDEX_REBUILD_SCHEDULE_ENABLED=true
# Leave empty to delete the managed Temporal schedule.
INDEX_REBUILD_SCHEDULE_CRON=* * * * *
INDEX_REBUILD_SCHEDULE_TIMEZONE=UTC
INDEX_RETAIN_VERSIONS=5
INDEX_BUILD_THREADS=2

# Optional: set this in production to avoid anonymous Hugging Face Hub rate limits.
# HF_TOKEN=


HTTP_API_KEY_ADMIN=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">
HTTP_API_KEY_READONLY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">

# GitHub OAuth for the admin web UI. Development mode leaves admin routes open.
AUTH_GITHUB_CLIENT_ID=Ov23ctpBXMcoxPE5CaGk
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
AUTH_ALLOWED_GITHUB_IDS=124798751
AUTH_SESSION_SECRET=<generate with: python -c "import secrets; print(secrets.token_urlsafe(48))">
AUTH_UI_URL=http://localhost:3000
# Production uses .mimeme.dev so the web worker can forward the backend session.
# AUTH_COOKIE_DOMAIN=.mimeme.dev

# Prod only: cloudflared tunnel token from `terraform output -raw cloudflare_tunnel_token`
CLOUDFLARE_TUNNEL_TOKEN=

# Production log shipping/query credentials. The ingest token is used by the
# Vector sidecar; the query token is used only by the admin ingestion viewer.
LOG_AXIOM_DATASET=
LOG_AXIOM_REGION=us-east-1.aws.edge.axiom.co
LOG_AXIOM_API_TOKEN=
LOG_AXIOM_QUERY_TOKEN=
