
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

DB_URL=postgresql://postgres:postgres@localhost:5432/mimeme

REDIS_URL=redis://localhost:6379/0

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=findmeme-tasks
# GPU_BACKEND=local|modal (default: local)
MODAL_APP_NAME=findmeme-gpu

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mimeme
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRY=3600

VISION_MODEL=vikhyatk/moondream2
VISION_MODEL_REVISION=2025-06-21
EMBED_MODEL=google/siglip2-base-patch16-naflex
EMBED_DEVICE=cuda
PRELOAD_TEXT_ENCODER_ON_STARTUP=true

INDEX_TYPE=hnsw
INDEX_CACHE_DIR=data/cache/indexes

# Optional: set this in production to avoid anonymous Hugging Face Hub rate limits.
# HF_TOKEN=


API_KEY_ADMIN=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">
API_KEY_READONLY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">

# Prod only: cloudflared tunnel token from `terraform output -raw cloudflare_tunnel_token`
CLOUDFLARE_TUNNEL_TOKEN=
