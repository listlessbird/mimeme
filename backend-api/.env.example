
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimeme

REDIS_URL=redis://localhost:6379/0

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=findmeme-tasks
# COMPUTE_GPU_BACKEND=local|modal (default: local)
COMPUTE_MODAL_APP_NAME=findmeme-gpu
# Compute gateway the API/worker call for image + model inference.
# In Compose this is http://compute:8010; host tools use http://127.0.0.1:8010.
COMPUTE_GATEWAY_URL=http://127.0.0.1:8010
# COMPUTE_BIND_HOST=0.0.0.0
# COMPUTE_BIND_PORT=8010
# COMPUTE_SOCKET_DIR=/tmp/mimeme-compute
# COMPUTE_POLL_INTERVAL_S=5.0
# COMPUTE_HEARTBEAT_TIMEOUT_S=30.0

MEDIA_S3_ENDPOINT_URL=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=minioadmin
MEDIA_S3_SECRET_ACCESS_KEY=minioadmin
MEDIA_S3_BUCKET=mimeme-media
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/mimeme-media

ARTIFACT_S3_ENDPOINT_URL=http://localhost:9000
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ACCESS_KEY_ID=minioadmin
ARTIFACT_S3_SECRET_ACCESS_KEY=minioadmin
ARTIFACT_S3_BUCKET=mimeme-artifacts
ARTIFACT_S3_FORCE_PATH_STYLE=true

INFERENCE_VISION_MODEL=vikhyatk/moondream2
INFERENCE_VISION_MODEL_REVISION=2025-06-21
INFERENCE_EMBED_MODEL=google/siglip2-base-patch16-naflex
INFERENCE_EMBED_DEVICE=cuda
SEARCH_ENCODER_REPO=listlessbird/siglip2-base-patch16-naflex-text-onnx
SEARCH_ENCODER_REVISION=092dc08370b1a01d69c78067051b124881a95407
SEARCH_ENCODER_VARIANT=text_model_int8.onnx
SEARCH_ENCODER_THREADS=4
SEARCH_HNSW_EF_SEARCH=128

INDEX_TYPE=hnsw
INDEX_CACHE_DIR=data/cache/indexes
INDEX_REBUILD_CLAIM_TIMEOUT_MINUTES=180
INDEX_REBUILD_SCHEDULE_ENABLED=true
INDEX_REBUILD_SCHEDULE_CRON=* * * * *
INDEX_REBUILD_SCHEDULE_TIMEZONE=UTC

# Optional: set this in production to avoid anonymous Hugging Face Hub rate limits.
# HF_TOKEN=


HTTP_API_KEY_ADMIN=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">
HTTP_API_KEY_READONLY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">

# Prod only: cloudflared tunnel token from `terraform output -raw cloudflare_tunnel_token`
CLOUDFLARE_TUNNEL_TOKEN=
