
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

DB_URL=postgresql://postgres:postgres@localhost:5432/findmeme

REDIS_URL=redis://localhost:6379/0

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_CPU=cpu-queue
TEMPORAL_TASK_QUEUE_GPU=gpu-queue

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=findmeme
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRY=3600

VISION_MODEL=vikhyatk/moondream2
VISION_MODEL_REVISION=2025-01-09
EMBED_MODEL=google/siglip2-base-patch16-naflex
EMBED_DEVICE=cuda

INDEX_TYPE=hnsw
INDEX_CACHE_DIR=data/cache/indexes