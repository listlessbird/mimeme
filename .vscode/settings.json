{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend-api/.venv/bin/python",
  "python.analysis.diagnosticMode": "workspace",
  "python.testing.cwd": "${workspaceFolder}/backend-api",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "ruff.configuration": "${workspaceFolder}/backend-api/pyproject.toml",
  "ruff.importStrategy": "fromEnvironment",
  "ruff.nativeServer": "on",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },
  "workbench.colorCustomizations": {
    "statusBar.background": "#335c99",
    "statusBar.foreground": "#ffffff",
    "sash.hoverBorder": "#335c99"
  }
}
