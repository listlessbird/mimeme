		"vaul": "1.1.2",
		"vite-tsconfig-paths": "6.0.5",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "0.3.12",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "22.19.9",
		"@types/pg": "8.16.0",
