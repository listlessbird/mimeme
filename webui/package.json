{
	"name": "webui",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run --config vitest.config.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"check": "oxfmt --check && oxlint --type-aware",
		"deploy": "bun run build && wrangler deploy",
		"gen:api": "uv run --project ../backend-api python ../backend-api/scripts/export_openapi.py ./openapi.json && openapi-typescript ./openapi.json -o src/lib/api/schema.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@base-ui/react": "1.2.0",
		"@cloudflare/vite-plugin": "1.23.1",
		"@hookform/resolvers": "5.2.2",
		"@t3-oss/env-core": "0.13.10",
		"@tailwindcss/vite": "4.1.18",
		"@tanstack/react-devtools": "0.7.11",
		"@tanstack/react-query": "5.90.20",
		"@tanstack/react-query-devtools": "5.91.3",
		"@tanstack/react-router": "1.158.1",
		"@tanstack/react-router-devtools": "1.158.1",
		"@tanstack/react-router-ssr-query": "1.158.1",
		"@tanstack/react-start": "1.158.3",
		"@tanstack/router-plugin": "1.158.1",
		"better-auth": "1.4.18",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.1.0",
		"drizzle-kit": "0.31.8",
		"drizzle-orm": "0.45.1",
		"embla-carousel-react": "8.6.0",
		"evlog": "2.0.0",
		"input-otp": "1.4.2",
		"lucide-react": "0.574.0",
		"motion": "12.34.1",
		"next-themes": "0.4.6",
		"nuqs": "2.8.8",
		"openapi-fetch": "^0.17.0",
		"pg": "8.18.0",
		"radix-ui": "1.4.3",
		"react": "19.2.4",
		"react-day-picker": "9.13.2",
		"react-dom": "19.2.4",
		"react-hook-form": "7.71.1",
		"react-resizable-panels": "4.6.4",
		"recharts": "2.15.4",
		"sonner": "2.0.7",
