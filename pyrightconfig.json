{
  "include": [
    "backend-api/src",
    "backend-api/tests"
  ],
  "extraPaths": [
    "backend-api",
    "backend-api/src"
  ],
  "executionEnvironments": [
    {
      "root": "backend-api",
      "pythonVersion": "3.13",
      "extraPaths": [
        "backend-api",
        "backend-api/src"
      ]
    }
  ],
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true,
  "reportMissingTypeStubs": false,
  "reportPrivateImportUsage": false
}
